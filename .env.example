# Copie para .env (nunca commite o .env)
POSTGRES_USER=myeconomy
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=myeconomy

# URLs públicas (ajuste se for expor na internet)
WEB_URL=http://localhost:5176
PUBLIC_API_URL=http://localhost:8085

# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
